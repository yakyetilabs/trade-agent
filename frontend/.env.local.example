# Firebase config for the trade-agent frontend (project trade-agent-ff12a).
#
# Copy this file to `.env.local` (gitignored) and fill VITE_FIREBASE_API_KEY. The other two
# required values are pre-filled for this project. VITE_FIREBASE_APP_ID is OPTIONAL (Analytics
# only) - Google sign-in works without it, so you do NOT need to register a Web App just to run
# the frontend.
#
# The API key is the project's browser key - the SAME value the backend already has in
# backend/.env as FIREBASE_WEB_API_KEY. (Or read it from the Firebase console: Project settings
# -> General -> Web API Key.)
#
# These are public client identifiers, NOT secrets: the real security boundary is the backend's
# in-memory allowlist (a non-allowlisted Google account authenticates but still gets a 403).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=trade-agent-ff12a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=trade-agent-ff12a

# Optional (Analytics only; not needed for Auth). Only set if you have a registered Web App.
VITE_FIREBASE_APP_ID=

# Optional. The API is same-origin, so this defaults to "/api" (Vite proxies it in dev, the
# Firebase Hosting rewrite serves it in prod). Only set this to point at a non-same-origin backend.
# VITE_API_BASE_URL=/api
