.DS_Store
Thumbs.db
.idea/
.vscode/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln

__pycache__/
*.py[cod]
*$py.class
.venv/
# uv package manager cache directory
.uv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.tox/

dist/
node_modules/
# Vite production build output
/frontend/dist/
.eslintcache
*.tsbuildinfo
# Firebase CLI local deploy cache (hosting file-hash manifest)
.firebase/
# Project-Specific Evaluation Artifacts
# Keeps heavy evaluation run json reports out of git history
/backend/eval/results/

.env
.env.local
.env.*
# ...but DO ship the example templates referenced by the quickstart
!.env.example
!.env.local.example
# ...and the frontend's production build config: non-secret (just the split-origin API base URL),
# so it is committed for a reproducible prod build. Scoped to frontend/ so backend .env* stay ignored.
!/frontend/.env.production
*.pem
*.key

# Prevent accidental leaks of downloaded GCP Service Account keys
*key*.json
*credentials*.json

# Local agent/tooling config — kept local, never committed
CLAUDE.md
CLAUDE.local.md
# Detailed session history moved off CLAUDE.local.md's auto-load path
SESSION_ARCHIVE.local.md
# Forward implementation-plan handoffs, kept local (opened on purpose, not auto-loaded)
PIVOT_PLAN.local.md
.claude/
