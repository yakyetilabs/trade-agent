# Copy to backend/.env and fill in. See docs/GCP_SETUP.md Step 8.
# This file is the template; .env itself is gitignored.

GCP_PROJECT=trade-agent-a5208
GCP_REGION=us-central1

# Vertex AI models (GA aliases) — consumed in the agent + KB phases
VERTEX_PRIMARY_MODEL=gemini-2.5-flash
VERTEX_EVAL_MODEL=gemini-2.5-pro
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_EMBEDDING_DIM=768

# Pinecone (knowledge base) — consumed in the KB phase
PINECONE_API_KEY=
PINECONE_INDEX=trade-agent-hts-kb

# $0 zero-trust authorization: analyst -> authorized vendor scope, parsed in-memory at
# boot. Format "email=V-001,V-002;email2=*" (entries split on ';', email/vendors on '=',
# vendor ids on ','). A lone '*' grants all vendors (admin). The map keys ARE the identity
# allowlist (who may use the app at all). Example: you are admin, a second analyst is scoped.
TRADE_AGENT_ANALYST_SCOPES=your-email@gmail.com=*;analyst@gmail.com=V-001,V-002

# "local" relaxes CORS to the Vite dev origin; "production" locks to PROD_FRONTEND_ORIGIN
APP_ENV=local
PROD_FRONTEND_ORIGIN=https://trade-agent-a5208.web.app

# Local dev only — Cloud Run uses its attached service account instead.
GOOGLE_APPLICATION_CREDENTIALS=./trade-agent-sa-key.json
