# Copy to backend/.env and fill in. See docs/GCP_SETUP.md Step 8.
# This file is the template; .env itself is gitignored.

GCP_PROJECT=trade-agent-ff12a
GCP_REGION=us-central1

# Vertex AI models (GA aliases) - consumed in the agent + KB phases
VERTEX_PRIMARY_MODEL=gemini-2.5-flash
VERTEX_EVAL_MODEL=gemini-2.5-pro
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_EMBEDDING_DIM=768

# Pinecone (knowledge base) - consumed in the KB phase
PINECONE_API_KEY=
PINECONE_INDEX=trade-agent-hts-kb

# In-app per-IP rate limiter (defaults compiled into src/config.py; set only to tune).
# RPM caps requests across /api/*; TPM budgets model tokens on the inquiry endpoints;
# the window is the refill horizon in seconds.
RATE_LIMIT_RPM=30
RATE_LIMIT_TPM=30000
RATE_LIMIT_WINDOW_SECONDS=60

# "local" relaxes CORS to the Vite dev origin; "production" locks to PROD_FRONTEND_ORIGINS
# (comma-separated browser origins the frontend is served from).
APP_ENV=local
PROD_FRONTEND_ORIGINS=https://tradeops-ai.samir.codes,https://trade-agent.samir.codes,https://trade-agent-ff12a.web.app,https://trade-agent-ff12a.firebaseapp.com

# Local dev only - Cloud Run uses its attached service account instead.
GOOGLE_APPLICATION_CREDENTIALS=./trade-agent-sa-key.json
